{
  "name": "@lumina/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=../.env.local src/server.ts",
    "seed": "tsx --env-file-if-exists=../.env.local src/seed.ts",
    "jobs": "tsx --env-file-if-exists=../.env.local src/jobs-loop.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:@resvg/resvg-js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && npm i --prefix dist --no-save --no-package-lock --os=linux --cpu=arm64 --libc=glibc @resvg/resvg-js@2.6.2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.35.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-lambda": "3.1152.0",
    "@aws-sdk/client-sns": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
